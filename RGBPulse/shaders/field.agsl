// Ten curated pulses: eight key-local effects and two intentionally wide effects.
// Actual key bounds determine local footprint; summed alpha is capped for fast typing.
uniform float2 resolution;
uniform float time;
uniform float strength;
uniform float effectSize;
uniform float thickness;
uniform float style;
uniform float colorMode;
uniform float hue1;
uniform float hue2;
uniform float saturation;
uniform float4 taps[4];
uniform float4 keyBounds[4];
float3 hueRgb(float h){
    float3 w=abs(fract(float3(h)+float3(0,.6666667,.3333333))*6-3);
    return mix(float3(1),clamp(w-1,0,1),saturation);
}
float3 palette(float phase,float hue){
    if(colorMode>2.5&&colorMode<3.5)return mix(hueRgb(hue1),hueRgb(hue2),clamp(phase,0,1));
    if(colorMode>1.5&&colorMode<2.5)return hueRgb(hue1);
    return hueRgb(hue+phase*.12+(colorMode<.5?time*.015:0));
}
float band(float d,float w){return exp(-d*d/(w*w));}
half4 main(float2 frag){
    float energy=0;float3 light=float3(0);
    for(int i=0;i<4;i++){
        float age=taps[i].z;
        if(age>0&&age<1){
            float4 box=keyBounds[i];
            float2 halfSize=max((box.zw-box.xy)*.5,float2(1));
            float2 center=(box.xy+box.zw)*.5;
            float2 u=(frag-center)/halfSize;
            float2 a=abs(u);
            float envelope=smoothstep(0,.07,age)*(1-smoothstep(.35,1,age));
            float intensity=0;
            float width=.09*clamp(thickness,.6,1.6)*clamp(effectSize,.85,1.15);
            if(style<7.5){
                // Hard finite footprint, with a soft edge: no keyboard-sized local waves.
                float clip=(1-smoothstep(1.06,1.20,a.x))*(1-smoothstep(1.06,1.20,a.y));
                if(style<.5){
                    float edge=band(max(a.x,a.y)-.88,width);
                    float angle=atan(u.y,u.x)*.1591549+.5;
                    float travel=fract(angle-age);
                    intensity=edge*(.12+.88*exp(-travel*9));
                }else if(style<1.5){
                    float edge=band(max(a.x,a.y)-(.70+.22*age),width);
                    intensity=edge*smoothstep(.40,.72,min(a.x,a.y));
                }else if(style<2.5){
                    float head=-.9+1.8*age;
                    intensity=band(u.y-.83,width)*band(u.x-head,.38);
                }else if(style<3.5){
                    intensity=band(u.x+u.y-(-1.4+2.8*age),.15)*(1-smoothstep(.82,1,max(a.x,a.y)));
                }else if(style<4.5){
                    float reach=.5+.52*age;
                    float d=min(abs(u.x-reach)+a.y,abs(u.x+reach)+a.y);
                    d=min(d,min(a.x+abs(u.y-reach),a.x+abs(u.y+reach)));
                    intensity=1-smoothstep(.08,.22,d);
                }else if(style<5.5){
                    float r=length((frag-center)/max(1,min(halfSize.x,halfSize.y)));
                    intensity=band(r-(.12+.8*age),width);
                }else if(style<6.5){
                    intensity=band(a.x-(.15+.72*age),.12)*(1-smoothstep(.35,.85,a.y));
                }else{
                    intensity=.72*exp(-(u.x*u.x+u.y*u.y)/(.18+.3*sin(age*3.14159)));
                }
                intensity*=clip;
            }else{
                float2 p=(frag-taps[i].xy)/max(resolution.y,1);
                if(style<8.5)intensity=band(length(p)-age*1.25,.025);
                else intensity=band(p.y+age*.95-.16*sin(p.x*4+age*3),.075)*exp(-p.x*p.x/2);
            }
            float weight=clamp(intensity*envelope,0,1);
            energy+=weight;light+=palette(age+u.x*.1,taps[i].w)*weight;
        }
    }
    // This cap applies to the combined light, not separately per tap.
    float cap=style<7.5?.48:.28;
    float alpha=min(cap,energy*.55)*clamp(strength,0,1);
    return half4(clamp(light/max(energy,.0001),0,1)*alpha,alpha);
}
