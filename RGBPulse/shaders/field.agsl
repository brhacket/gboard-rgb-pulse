// Sixteen curated RGB pulses: twelve key-local effects and four wide
// background effects. The language is classic RGB lighting: smooth flowing
// hue waves, ripples and sweeps — layered as a saturated color body, a soft
// halo and a gentle sheen. Motion is eased from the tap age; hue travels
// across each feature so everything reads as flowing color, not noise.
// Actual key bounds determine local footprint; summed alpha is capped.
uniform float2 resolution;
uniform float time;
uniform float strength;
uniform float effectSize;
uniform float thickness;
uniform float style;
uniform float colorMode;
uniform float hue1;
uniform float hue2;
uniform float saturation;
uniform float4 taps[4];
uniform float4 keyBounds[4];
float3 hueRgb(float h){
    float3 w=abs(fract(float3(h)+float3(0,.6666667,.3333333))*6-3);
    return mix(float3(1),clamp(w-1,0,1),saturation);
}
// Body color of the palette; phase also drives the two-color gradient and,
// in cycling modes, slides the hue so color flows across the feature.
float3 body(float phase,float hue){
    if(colorMode>2.5&&colorMode<3.5)return mix(hueRgb(hue1),hueRgb(hue2),clamp(phase,0,1));
    if(colorMode>1.5&&colorMode<2.5)return hueRgb(hue1+phase*.15);
    return hueRgb(hue+phase*.35+(colorMode<.5?time*.03:0));
}
float band(float d,float w){return exp(-d*d/(w*w));}
float sq(float x){return x*x;}
float eo(float t){t=clamp(t,0.,1.);return 1.-pow(1.-t,3.);}
float4 L(float3 c,float w){return float4(c*w,w);}
half4 main(float2 frag){
    float energy=0;float3 light=float3(0);
    for(int i=0;i<4;i++){
        float age=taps[i].z;
        if(age>0&&age<1){
            float4 box=keyBounds[i];
            float2 halfSize=max((box.zw-box.xy)*.5,float2(1));
            float2 center=(box.xy+box.zw)*.5;
            float2 u=(frag-center)/halfSize;
            float2 a=abs(u);
            float envelope=smoothstep(0,.07,age)*(1-smoothstep(.35,1,age));
            float hue=taps[i].w;
            float4 acc=float4(0);
            float width=.12*clamp(thickness,.6,1.6)*clamp(effectSize,.85,1.15);
            if(style<11.5){
                float clip=(1-smoothstep(1.06,1.20,a.x))*(1-smoothstep(1.06,1.20,a.y));
                if(style<.5){
                    // Rainbow ring: hue circulates around the key rim and rotates.
                    float d=max(a.x,a.y);
                    float ang=atan(u.y,u.x)*.1591549;
                    float ring=band(d-.86,width*2.2);
                    acc+=L(body(ang+age*.9,hue),ring*.95);
                    acc+=L(float3(1),ring*ring*.35);
                    acc+=L(body(ang+age*.9+.1,hue),band(d-.86,width*4.5)*.35);
                }else if(style<1.5){
                    // Corner pulse: four corner glows swell outward, hue by quadrant.
                    float2 q=abs(u)-(.58+.28*eo(age));
                    float g=exp(-dot(q,q)*7.);
                    float ang=atan(u.y,u.x)*.1591549;
                    acc+=L(body(ang+age*.4,hue),g*.95);
                    acc+=L(float3(1),g*g*.4);
                    acc+=L(body(ang+.12,hue),exp(-dot(q,q)*3.)*.3);
                }else if(style<2.5){
                    // Underline wave: a rainbow underline with a soft passing sheen.
                    float y=u.y-.8;
                    float grad=band(y,width*2.);
                    float hs=u.x*.35+age*.4;
                    float hx=eo(age)*2.-1.;
                    acc+=L(body(hs,hue),grad*.95);
                    acc+=L(float3(1),grad*grad*.3+exp(-sq(u.x-hx)*18.)*grad*.5);
                    acc+=L(body(hs+.1,hue),band(y,width*4.5)*.3);
                }else if(style<3.5){
                    // Diagonal wave: a wide smooth spectral band glides across the key.
                    float v=(u.x+u.y)*.7071;
                    float c=-1.2+2.4*eo(age);
                    float m=1.-smoothstep(.9,1.1,max(a.x,a.y));
                    acc+=L(body(v*.3+age*.3,hue),band(v-c,width*3.5)*.95*m);
                    acc+=L(float3(1),band(v-c,width*1.2)*.35*m);
                    acc+=L(body(v*.3+.15,hue),band(v-c,width*7.)*.25*m);
                }else if(style<4.5){
                    // Quad pulse: four soft orbs at the edge midpoints drift outward,
                    // each a quarter turn of hue apart.
                    float reach=.5+.38*eo(age);
                    for(int k=0;k<4;k++){
                        float2 dir=k==0?float2(1,0):(k==1?float2(-1,0):(k==2?float2(0,1):float2(0,-1)));
                        float2 q=u-dir*reach;
                        float g=exp(-dot(q,q)*8.);
                        acc+=L(body(float(k)*.25+age*.3,hue),g*.9);
                        acc+=L(float3(1),g*g*.35);
                    }
                    acc+=L(body(age*.3,hue),exp(-dot(u,u)*3.)*.3*(1-age));
                }else if(style<5.5){
                    // Rainbow ripple: an expanding ring whose hue runs around the
                    // circumference, with a soft halo and a gentle center glow.
                    float r=length(u);
                    float R=.1+.85*eo(age);
                    float ang=atan(u.y,u.x)*.1591549;
                    acc+=L(body(ang*.5+age*.3,hue),band(r-R,width*2.2)*.95);
                    acc+=L(float3(1),band(r-R,width*.9)*.3);
                    acc+=L(body(ang*.5+.1,hue),band(r-R,width*4.5)*.3);
                    acc+=L(body(age*.4,hue),exp(-r*r*6.)*(1-age)*.5);
                }else if(style<6.5){
                    // Side waves: two vertical color waves part from the center.
                    float s=eo(age)*.8;
                    float mask=1.-smoothstep(.6,1.,a.y);
                    for(int k=0;k<2;k++){
                        float x=k==0?u.x+s:u.x-s;
                        float g=exp(-x*x/(width*6.))*mask;
                        acc+=L(body(u.y*.2+float(k)*.25+age*.3,hue),g*.9);
                        acc+=L(float3(1),g*g*.25);
                    }
                    acc+=L(body(age*.3,hue),exp(-u.x*u.x*8.)*exp(-age*6.)*.5*mask);
                }else if(style<7.5){
                    // Breathing glow: one large soft pulse of slowly drifting color.
                    float r2=dot(u,u);
                    float breathe=1.+.12*sin(age*6.28318);
                    float core=exp(-r2/(.30*breathe));
                    acc+=L(body(age*.5,hue),core);
                    acc+=L(float3(1),core*core*.4);
                    acc+=L(body(age*.5+.15,hue),exp(-r2/.85)*.4);
                }else if(style<8.5){
                    // Bloom wave: four smooth color petals open from the center,
                    // hue rotating around them.
                    float r=length(u);
                    float ang=atan(u.y,u.x);
                    float grow=.2+.7*eo(age);
                    float lobes=.7+.3*cos(4.*ang+3.141592);
                    float d=r-grow*lobes;
                    float petal=exp(-d*d/.05);
                    acc+=L(body(ang*.25+age*.3,hue),petal*.9);
                    acc+=L(float3(1),petal*petal*.35);
                    acc+=L(body(ang*.25+.12,hue),exp(-d*d/.2)*.3);
                }else if(style<9.5){
                    // Pulse cross: soft horizontal and vertical color bars flash
                    // gently, meeting in a calm center glow.
                    float len=.3+.6*eo(age);
                    float hx=exp(-u.y*u.y/(width*5.))*(1.-smoothstep(len,len+.2,a.x));
                    float vy=exp(-u.x*u.x/(width*5.))*(1.-smoothstep(len,len+.2,a.y));
                    acc+=L(body(u.x*.25+age*.3,hue),hx*.85);
                    acc+=L(body(u.y*.25+.5+age*.3,hue),vy*.85);
                    acc+=L(float3(1),hx*vy*.5);
                }else if(style<10.5){
                    // Orbit glow: a rainbow arc sweeps around the key like a
                    // smooth loading ring.
                    float r=length(u);
                    float ang=atan(u.y,u.x)*.1591549;
                    float arc=.3+.7*exp(-fract(ang-age*1.2)*2.5);
                    float ring=band(r-.75,width*2.5);
                    acc+=L(body(ang+age*.4,hue),ring*arc*.95);
                    acc+=L(float3(1),band(r-.75,width)*arc*.3);
                    acc+=L(body(ang+.15,hue),band(r-.75,width*5.)*arc*.25);
                }else{
                    // Liquid rise: a rainbow fill level rises and drains behind a
                    // smooth bright meniscus.
                    float level=-1.+2.2*sin(age*3.14159);
                    float fill=1.-smoothstep(level-.1,level+.1,u.y);
                    acc+=L(body(u.y*.3+age*.2,hue),fill*.55);
                    acc+=L(body(u.x*.2+age*.3,hue),band(u.y-level,width*2.)*.9);
                    acc+=L(float3(1),band(u.y-level,width*.8)*.35);
                }
                // A soft bloom around the key rim grounds every effect on its key.
                acc+=L(body(age*.3,hue),band(max(a.x,a.y)-.88,width*3.)*.2);
                acc*=clip;
            }else{
                float2 p=(frag-taps[i].xy)/max(resolution.y,1);
                if(style<12.5){
                    // Wave sweep: a broad rainbow wave glides across the keyboard.
                    float xc=mix(-1.6,1.6,eo(age));
                    float d=p.x-xc;
                    acc+=L(body(p.x*.25+age*.2,hue),exp(-d*d/.35)*.9);
                    acc+=L(float3(1),exp(-d*d/.08)*.35);
                    acc+=L(body(p.x*.25+.2,hue),exp(-d*d/1.2)*.3);
                }else if(style<13.5){
                    // Aura ripple: a wide rainbow ring expands from the tap.
                    float r=length(p);
                    float R=1.3*eo(age);
                    float ang=atan(p.y,p.x)*.1591549;
                    acc+=L(body(ang+age*.3,hue),band(r-R,.12)*.9);
                    acc+=L(float3(1),band(r-R,.05)*.35);
                    acc+=L(body(ang+.15,hue),band(r-R,.35)*.3);
                }else if(style<14.5){
                    // Color wash: the whole keyboard breathes with a drifting hue
                    // gradient and one soft radial pulse at the tap.
                    float3 wash=body(p.x*.2+p.y*.15+age*.4,hue);
                    float bandY=exp(-sq(p.y-(-1.+2.*eo(age)))*.8);
                    acc+=L(wash,bandY*.7);
                    acc+=L(wash,exp(-dot(p,p)*.9)*.6*(1-age));
                    acc+=L(float3(1),exp(-dot(p,p)*2.5)*.3*(1-age));
                }else{
                    // Curtain wave: three smooth spectral curtains sway across.
                    float xc=-1.6+3.2*eo(age);
                    for(int k=0;k<3;k++){
                        float off=(float(k)-1.)*.4;
                        float wx=xc+off+.15*sin(p.y*(2.5+float(k)*.7)+time*.4*float(k));
                        float d=p.x-wx;
                        float cur=exp(-d*d/.09);
                        acc+=L(body(float(k)*.3+p.y*.1+age*.2,hue),cur*.75);
                    }
                    acc+=L(body(p.y*.15+age*.2,hue),exp(-(p.x-xc)*(p.x-xc)/.7)*.15);
                }
            }
            float weight=acc.w*envelope;
            energy+=weight;light+=acc.xyz*envelope;
        }
    }
    // This cap applies to the combined light, not separately per tap.
    float cap=style<11.5?.48:.40;
    float alpha=min(cap,energy*.7)*clamp(strength,0,1);
    return half4(clamp(light/max(energy,.0001),0,1)*alpha,alpha);
}
