// Ten curated pulses: eight key-local effects and two intentionally wide effects.
// Every pulse stacks layered light — a hot near-white core, a saturated body,
// a soft halo and a prismatic fringe that disperses hue across the feature.
// Actual key bounds determine local footprint; summed alpha is capped for fast typing.
uniform float2 resolution;
uniform float time;
uniform float strength;
uniform float effectSize;
uniform float thickness;
uniform float style;
uniform float colorMode;
uniform float hue1;
uniform float hue2;
uniform float saturation;
uniform float4 taps[4];
uniform float4 keyBounds[4];
float3 hueRgb(float h){
    float3 w=abs(fract(float3(h)+float3(0,.6666667,.3333333))*6-3);
    return mix(float3(1),clamp(w-1,0,1),saturation);
}
// Body color of the palette; phase also drives the two-color gradient.
float3 body(float phase,float hue){
    if(colorMode>2.5&&colorMode<3.5)return mix(hueRgb(hue1),hueRgb(hue2),clamp(phase,0,1));
    if(colorMode>1.5&&colorMode<2.5)return hueRgb(hue1);
    return hueRgb(hue+phase*.12+(colorMode<.5?time*.015:0));
}
// Prismatic variant: the hue (or gradient position) slides with f, so the
// edges of every feature disperse into neighboring colors like light in glass.
float3 prism(float phase,float hue,float f){
    if(colorMode>2.5&&colorMode<3.5)return mix(hueRgb(hue1),hueRgb(hue2),clamp(phase+f,0,1));
    if(colorMode>1.5&&colorMode<2.5)return hueRgb(hue1+f*.45);
    return hueRgb(hue+f+phase*.12+(colorMode<.5?time*.015:0));
}
float band(float d,float w){return exp(-d*d/(w*w));}
float sq(float x){return x*x;}
float eo(float t){t=clamp(t,0.,1.);return 1.-pow(1.-t,3.);}
float4 L(float3 c,float w){return float4(c*w,w);}
half4 main(float2 frag){
    float energy=0;float3 light=float3(0);
    for(int i=0;i<4;i++){
        float age=taps[i].z;
        if(age>0&&age<1){
            float4 box=keyBounds[i];
            float2 halfSize=max((box.zw-box.xy)*.5,float2(1));
            float2 center=(box.xy+box.zw)*.5;
            float2 u=(frag-center)/halfSize;
            float2 a=abs(u);
            float envelope=smoothstep(0,.07,age)*(1-smoothstep(.35,1,age));
            float hue=taps[i].w;
            float4 acc=float4(0);
            float width=.12*clamp(thickness,.6,1.6)*clamp(effectSize,.85,1.15);
            if(style<7.5){
                // Hard finite footprint, with a soft edge: no keyboard-sized local waves.
                float clip=(1-smoothstep(1.06,1.20,a.x))*(1-smoothstep(1.06,1.20,a.y));
                if(style<.5){
                    // Edge runner: a white-hot comet circles the rim, trailing a spectral tail.
                    float d=max(a.x,a.y);
                    float edge=band(d-.88,width*1.5);
                    float ang=atan(u.y,u.x)*.1591549+.5;
                    float head=eo(age)*1.15;
                    float behind=fract(ang-head+1.);
                    float tail=exp(-behind*5.);
                    float hg=edge*exp(-sq(fract(ang-head+.5)-.5)*60.);
                    acc+=L(prism(age,hue,-behind*.45),edge*tail);
                    acc+=L(float3(1),hg*1.1);
                    acc+=L(body(age,hue),hg*.7+edge*.2);
                    acc+=L(prism(age,hue,.3),band(d-.88,width*3.2)*(tail*.6+.2)*.35);
                }else if(style<1.5){
                    // Corner snap: brackets spring in from outside, overshoot and settle,
                    // with a hot tip and a snap flash as they land.
                    float s=.82+.30*exp(-5.5*age)*cos(10.*age);
                    float2 q=abs(u)-s;
                    // Two slim arms per corner form a crisp L bracket pointing inward.
                    float inX=1.-smoothstep(.02,.12,q.x);
                    float inY=1.-smoothstep(.02,.12,q.y);
                    float armX=band(q.y,width*1.2)*(1.-smoothstep(.38,.5,abs(q.x)))*inX;
                    float armY=band(q.x,width*1.2)*(1.-smoothstep(.38,.5,abs(q.y)))*inY;
                    float br=max(armX,armY);
                    float dotc=exp(-dot(q,q)*18.);
                    float flash=exp(-sq((age-.34)*7.));
                    acc+=L(body(age,hue),br*1.1);
                    acc+=L(float3(1),dotc*(.5+.8*flash));
                    acc+=L(body(age,hue),exp(-dot(q,q)*9.)*.35);
                    acc+=L(prism(age,hue,.35),br*.4);
                }else if(style<2.5){
                    // Underline: a calligraphic stroke with a bright head, arced baseline
                    // and a spectral tail left behind the sweep.
                    float head=-.92+1.84*eo(age);
                    float arc=.84+.05*sin((u.x+.9)*2.4);
                    float along=head-u.x;
                    float stroke=band(u.y-arc,width*1.7)*exp(-max(along,0.)*1.6)*smoothstep(-.08,.02,along+width*4.);
                    float hg=exp(-dot(u-float2(head,arc),u-float2(head,arc))*14.);
                    acc+=L(body(age,hue),stroke*1.1);
                    acc+=L(prism(age,hue,-.4),stroke*.6*smoothstep(0.,.5,along));
                    acc+=L(float3(1),hg);
                    acc+=L(body(age,hue),band(u.y-arc,width*4.)*exp(-max(along,0.)*1.2)*.3);
                    acc+=L(prism(age,hue,.4),band(u.y-arc,width*3.4)*exp(-max(along,0.)*1.4)*.35);
                }else if(style<3.5){
                    // Prism swipe: a diagonal gleam split into dispersed color bands,
                    // white-hot where they overlap.
                    float v=(u.x+u.y)*.7071;
                    float c=-1.4+2.8*eo(age);
                    float m=1.-smoothstep(.82,1.,max(a.x,a.y));
                    float wR=band(v-c-width*2.,width*1.3);
                    float wG=band(v-c,width*1.3);
                    float wB=band(v-c+width*2.,width*1.3);
                    acc+=L(prism(age,hue,-.18),wR*.9*m);
                    acc+=L(body(age,hue),wG*1.1*m);
                    acc+=L(prism(age,hue,.18),wB*.9*m);
                    acc+=L(float3(1),wG*wG*.9*m);
                    acc+=L(body(age,hue),band(v-c,width*4.)*.25*m);
                }else if(style<4.5){
                    // Four sparks: twinkling diamond sparks fly from the edge midpoints,
                    // each with a streak back toward the key and a white tip.
                    float reach=.25+.85*eo(age);
                    float tw=.7+.3*sin(time*42.+hue*6.28318);
                    for(int k=0;k<4;k++){
                        float2 dir=k==0?float2(1,0):(k==1?float2(-1,0):(k==2?float2(0,1):float2(0,-1)));
                        float2 q=u-dir*reach;
                        float along=dot(q,-dir);
                        float perp=abs(dot(q,float2(dir.y,-dir.x)));
                        float streak=exp(-(abs(along)*3.+perp*9.))*tw;
                        float core=exp(-(abs(q.x)+abs(q.y))*7.);
                        float tip=exp(-dot(q,q)*24.);
                        acc+=L(body(age,hue),streak);
                        acc+=L(prism(age,hue,.3),streak*.4);
                        acc+=L(body(age,hue),core*.8);
                        acc+=L(body(age,hue),exp(-dot(q,q)*10.)*.5);
                        acc+=L(float3(1),tip);
                    }
                    acc+=L(body(age,hue),band(max(a.x,a.y)-.9,width*1.4)*exp(-age*6.)*.4);
                }else if(style<5.5){
                    // Drop ring: a chromatic ring with a hot crest, an inner echo and a
                    // droplet highlight left at the tap point.
                    float r=length(u);
                    float R=.12+.85*eo(age);
                    float ring=band(r-R,width*1.2);
                    acc+=L(prism(age,hue,-.25),band(r-R-width*1.5,width*.9)*.8);
                    acc+=L(prism(age,hue,.25),band(r-R+width*1.5,width*.9)*.8);
                    acc+=L(body(age,hue),ring);
                    acc+=L(float3(1),ring*ring*.9);
                    acc+=L(body(age,hue),band(r-R*.55,width*.8)*(1-age)*.5);
                    acc+=L(float3(1),exp(-r*r*8.)*(1-age)*.8);
                    acc+=L(body(age,hue),band(r-R,width*3.)*.3);
                }else if(style<6.5){
                    // Split shutters: two bowed slivers of light part from a seam flash,
                    // each with a bright spine and prismatic edges.
                    float s=eo(age)*.78;
                    float bow=.06*sin(u.y*2.2);
                    float xr=abs(u.x)-s+bow;
                    float mask=1.-smoothstep(.5,1.,a.y);
                    float sliver=band(xr,width*1.4)*mask;
                    acc+=L(body(age,hue),sliver);
                    acc+=L(float3(1),band(xr,width*.6)*mask*.6);
                    acc+=L(prism(age,hue,.3),band(xr,width*3.)*mask*.35);
                    acc+=L(float3(1),exp(-u.x*u.x*30.)*exp(-age*7.)*.9*mask);
                }else{
                    // Soft press: a breathing glow with a hot core, wide colored halo and a
                    // slowly expanding prismatic rim.
                    float r2=u.x*u.x+u.y*u.y;
                    float breathe=1.+.10*sin(age*6.28318);
                    float core=exp(-r2/(.20*breathe));
                    float halo=exp(-r2/(.65*breathe));
                    float rim=band(sqrt(r2)-(.45+.35*eo(age)),width*1.8);
                    acc+=L(body(age,hue),core*1.05);
                    acc+=L(float3(1),core*core*.8);
                    acc+=L(prism(age,hue,.3),halo*.45);
                    acc+=L(body(age,hue),halo*.35);
                    acc+=L(prism(age,hue,-.3),rim*.5);
                }
                acc*=clip;
            }else{
                float2 p=(frag-taps[i].xy)/max(resolution.y,1);
                if(style<8.5){
                    // Comet sweep: a white-hot comet crosses the keyboard along the tap
                    // row, trailing a long spectral tail with sparkle and a broad halo.
                    float travel=mix(-1.4,1.6,eo(age));
                    float dx=p.x-travel;
                    float back=max(-dx,0.);
                    float py=p.y-.10*sin(p.x*1.8+1.7*age);
                    float lane=exp(-py*py*14.);
                    float head=exp(-dx*dx*34.)*exp(-py*py*30.);
                    float tail=exp(-back*2.2)*lane*smoothstep(0.,.06,back);
                    float halo=exp(-dx*dx*3.)*exp(-p.y*p.y*4.);
                    acc+=L(float3(1),head*1.4);
                    acc+=L(body(age,hue),head);
                    acc+=L(prism(age,hue,-min(back*.5,1.)*.45),tail*.85);
                    acc+=L(float3(1),tail*.35*exp(-back*6.));
                    acc+=L(body(age,hue),tail*.22*(.6+.4*sin(p.x*31.+time*5.)));
                    acc+=L(prism(age,hue,.3),halo*.15);
                }else{
                    // Nebula bloom: a lobed shell of light blooms outward from the tap,
                    // shimmering, with chromatic edges and a fading inner glow.
                    float r=length(p);
                    float ang=atan(p.y,p.x);
                    float grow=.2+1.05*eo(age);
                    float lobes=.75+.25*sin(ang*3.+time*.7)+.15*sin(ang*5.-time*.5);
                    float d=r-grow*lobes;
                    float shim=.75+.25*sin(ang*9.+time*2.);
                    float shell=exp(-d*d/.028)*shim;
                    acc+=L(float3(1),shell*shell*1.1);
                    acc+=L(body(age,hue),shell*.9);
                    acc+=L(prism(age,hue,-.3),band(d+.045,.04)*.55);
                    acc+=L(prism(age,hue,.3),band(d-.045,.04)*.55);
                    acc+=L(prism(age,hue,.2),exp(-d*d/.18)*.25);
                    acc+=L(body(age,hue),exp(-r*r/(grow*grow*.4))*(1-age)*.3);
                }
            }
            float weight=acc.w*envelope;
            energy+=weight;light+=acc.xyz*envelope;
        }
    }
    // This cap applies to the combined light, not separately per tap.
    float cap=style<7.5?.48:.40;
    float alpha=min(cap,energy*.7)*clamp(strength,0,1);
    return half4(clamp(light/max(energy,.0001),0,1)*alpha,alpha);
}
