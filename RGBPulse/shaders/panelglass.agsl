// Weighted sharp / Gaussian branches combined with PLUS (premultiplied addition).
// Neither branch contains legends, editor content or a captured View hierarchy.
uniform shader backdrop;
uniform float2 resolution;
uniform float density;
uniform float lensAmount;
uniform float textureAmount;
uniform float frostAmount;
uniform float roundness;
uniform float metalAmount;
uniform float blurredPass;
uniform float keyCount;
uniform float4 keys[64];
// Rounded lens outline. At maximum roundness letter keys approach circular bubbles;
// wide keys retain their width as capsules. Touch rectangles remain unchanged.
float sd(float2 p,float4 b){
 float2 h=max((b.zw-b.xy)*.5,float2(1.0));
 float radius=min(h.x,h.y)*mix(.40,1.0,clamp(roundness,0.0,1.0));
 float2 q=abs(p-(b.xy+b.zw)*.5)-h+radius;
 return length(max(q,0.0))+min(max(q.x,q.y),0.0)-radius;
}
float hash(float2 p){float3 q=fract(float3(p.xyx)*.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}
half4 main(float2 p){
 if(p.x<0.0||p.y<0.0||p.x>=resolution.x||p.y>=resolution.y)return half4(0);
 float4 b=float4(0.0);float d=1e5;
 for(int i=0;i<64;i++){
  if(float(i)>=keyCount)break;
  float4 k=keys[i];
  if(k.z<=k.x||k.w<=k.y||p.x<k.x-1.0||p.y<k.y-1.0||p.x>k.z+1.0||p.y>k.w+1.0)continue;
  float distance=sd(p,k);
  if(distance<d){d=distance;b=k;}
 }
 float2 lo=float2(.5),hi=max(resolution-.5,lo);
 half4 original=backdrop.eval(clamp(p,lo,hi));
 if(d>.7)return blurredPass>.5?half4(0):original;
 float cov=1.0-smoothstep(-.7,.7,d);
 float2 center=(b.xy+b.zw)*.5,h=(b.zw-b.xy)*.5;
 float2 q=(p-center)/max(h,float2(1));
 float2 normal=float2(sd(p+float2(.5,0),b)-sd(p-float2(.5,0),b),sd(p+float2(0,.5),b)-sd(p-float2(0,.5),b));
 normal/=max(length(normal),.0001);
 float halfShort=min(h.x,h.y),bevel=min(9.0*density,halfShort*.78);
 float t=clamp(-d/max(bevel,1.0),0.0,1.0);
 float slope=(pow(1.0+4.0*t,-1.35)-pow(5.0,-1.35))/(1.0-pow(5.0,-1.35));
 float2 bend=-normal*slope*min(9.5*density,halfShort*.70)*lensAmount;
 bend-=q*halfShort*max(0.0,1.0-dot(q,q)*.5)*.13*lensAmount;
 float dispersion=.035*slope;
 half4 red=backdrop.eval(clamp(p+bend*(1.0-dispersion),lo,hi));
 half4 green=backdrop.eval(clamp(p+bend,lo,hi));
 half4 blue=backdrop.eval(clamp(p+bend*(1.0+dispersion),lo,hi));
 float alpha=max(red.a,max(green.a,blue.a));
 float3 rgb=min(float3(red.r,green.g,blue.b),float3(alpha));
 float frost=clamp(frostAmount,0.0,1.0);
 float amount=smoothstep(0.0,.85,frost);
 // Convex glass: thin Fresnel edge, inner returning highlight and broad sky reflection.
 // No solid colored cap: diffuse backdrop remains visible through the curved surface.
 float facing=dot(normal,float2(-.60,-.80));
 float fresnel=exp(-max(-d,0.0)/max(.85*density,.5));
 float outer=fresnel*(.075+.52*pow(max(facing,0.0),3.0)+.18*pow(max(-facing,0.0),5.0));
 float innerDistance=(d+2.2*density)/max(.6*density,.5);
 float innerLine=exp(-innerDistance*innerDistance);
 float returned=innerLine*.12*pow(max(-facing,0.0),3.0);
 float ell=q.x*q.x*.8+(q.y+.72)*(q.y+.72)*2.8;
 float sky=exp(-ell*2.2)*.16;
 float lower=exp(-(q.x*q.x*2.0+(q.y-.82)*(q.y-.82)*20.0))*.035;
 float grain=(hash(floor((p-b.xy)/density*3.1))-.5)*.012*textureAmount;
 float top=clamp(.006+.025*frost+outer+returned+sky+lower+grain,0.0,.80);
 // Thin brushed-silver rim, inside the lens boundary; directional bright/dark bands.
 float rim=1.0-smoothstep(.65*density,1.35*density,max(-d,0.0));
 float metallic=clamp(metalAmount,0.0,1.0)*rim;
 float silver=.28+.65*pow(abs(facing),3.0);
 float brush=(hash(floor(p/density*3.0))-.5)*.028;
 float3 material=float3(.92,.96,1.0)*top;
 material=material*(1.0-metallic)+float3(silver*.94,silver*.97,silver+brush)*metallic;
 top=top+metallic*(1.0-top);
 // PLUS sum equals one weighted image, even for transparent backgrounds.
 // Material is added in the sharp branch only; the diffuse branch contributes no rim.
 if(blurredPass>.5)return half4(rgb,alpha)*(cov*amount*(1.0-top));
 rgb=material+rgb*((1.0-top)*(1.0-amount));
 alpha=top+alpha*((1.0-top)*(1.0-amount));
 return original*(1.0-cov)+half4(rgb,alpha)*cov;
}
